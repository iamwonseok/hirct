// Test: --export-cmodel generates C model artifact files from Arc MLIR input
//
// Combinational module (no clock) — should produce header + impl
// RUN: %hirct-gen %S/../../fixtures/CombOnly.mlir -o %t --export-cmodel
// RUN: test -f %t/CombOnly.h
// RUN: test -f %t/CombOnly.cpp
// RUN: %FileCheck %s --check-prefix=CHECK-COMB-H < %t/CombOnly.h
// RUN: %FileCheck %s --check-prefix=CHECK-COMB-CPP < %t/CombOnly.cpp
//
// CHECK-COMB-H: CombOnly_state
// CHECK-COMB-H: CombOnly_initialize
// CHECK-COMB-H: eval_comb
//
// CHECK-COMB-CPP: CombOnly_initialize
// CHECK-COMB-CPP: CombOnly_eval_comb
//
// Clocked module — should produce header + impl with clock eval
// RUN: %hirct-gen %S/../../fixtures/CounterArc.mlir -o %t_clk --export-cmodel
// RUN: test -f %t_clk/CounterArc.h
// RUN: test -f %t_clk/CounterArc.cpp
// RUN: %FileCheck %s --check-prefix=CHECK-CLK-H < %t_clk/CounterArc.h
// RUN: %FileCheck %s --check-prefix=CHECK-CLK-CPP < %t_clk/CounterArc.cpp
//
// Invalid --top must fail instead of silently falling back to another module.
// RUN: not %hirct-gen %S/../../fixtures/CounterArc.mlir -o %t_bad --top MissingTop --export-cmodel 2>&1 | %FileCheck %s --check-prefix=CHECK-BAD-TOP
//
// CHECK-CLK-H: CounterArc_state
// CHECK-CLK-H: CounterArc_initialize
// CHECK-CLK-H: eval_comb
//
// CHECK-CLK-CPP: CounterArc_initialize
// CHECK-CLK-CPP: CounterArc_eval_comb
//
// CHECK-BAD-TOP: Error: top module not found: MissingTop
//
// Memory module (seq.firmem) — should produce memory array and clock logic
// RUN: %hirct-gen %S/../../fixtures/FirmemBasic.mlir -o %t_mem --export-cmodel
// RUN: test -f %t_mem/FirmemBasic.h
// RUN: test -f %t_mem/FirmemBasic.cpp
// RUN: %FileCheck %s --check-prefix=CHECK-MEM-H < %t_mem/FirmemBasic.h
// RUN: %FileCheck %s --check-prefix=CHECK-MEM-CPP < %t_mem/FirmemBasic.cpp
//
// CHECK-MEM-H: FirmemBasic_state
// CHECK-MEM-H: memory_0[16]
// CHECK-MEM-H: eval_clock
//
// CHECK-MEM-CPP: FirmemBasic_eval_clock
// CHECK-MEM-CPP: memory_0[
// CHECK-MEM-CPP-NOT: unsupported:seq.firmem
