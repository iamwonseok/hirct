// Test: M3 Batch 1 — hierarchical C model export
// Covers: hierarchy traversal, leaf-first emit, dedup, unreachable exclusion,
//         cycle reject, self-instantiation reject.
//
// --- HierSimple: root + 1 child, both artifacts generated ---
// RUN: rm -rf %t_simple
// RUN: %hirct-gen %S/../../fixtures/HierSimple.mlir -o %t_simple --export-cmodel --top Top
// RUN: test -f %t_simple/Top.h
// RUN: test -f %t_simple/Top.cpp
// RUN: test -f %t_simple/Adder8.h
// RUN: test -f %t_simple/Adder8.cpp
//
// Both artifacts should contain valid state/eval_comb declarations
// RUN: %FileCheck %s --check-prefix=CHECK-SIMPLE-ROOT-H < %t_simple/Top.h
// RUN: %FileCheck %s --check-prefix=CHECK-SIMPLE-CHILD-H < %t_simple/Adder8.h
// CHECK-SIMPLE-ROOT-H: Top_state
// CHECK-SIMPLE-ROOT-H: Top_eval_comb
// CHECK-SIMPLE-CHILD-H: Adder8_state
// CHECK-SIMPLE-CHILD-H: Adder8_eval_comb
//
// --- HierDedup: same child instantiated twice, artifact generated once ---
// RUN: rm -rf %t_dedup
// RUN: %hirct-gen %S/../../fixtures/HierDedup.mlir -o %t_dedup --export-cmodel --top DedupTop
// RUN: test -f %t_dedup/DedupTop.h
// RUN: test -f %t_dedup/DedupTop.cpp
// RUN: test -f %t_dedup/Adder8.h
// RUN: test -f %t_dedup/Adder8.cpp
//
// --- HierUnreachable: Orphan module must NOT be exported ---
// RUN: rm -rf %t_unreach
// RUN: %hirct-gen %S/../../fixtures/HierUnreachable.mlir -o %t_unreach --export-cmodel --top UnreachTop
// RUN: test -f %t_unreach/UnreachTop.h
// RUN: test -f %t_unreach/Adder8.h
// RUN: test ! -f %t_unreach/Orphan.h
// RUN: test ! -f %t_unreach/Orphan.cpp
//
// --- HierCyclic: cyclic module instantiation must be rejected ---
// RUN: rm -rf %t_cyclic
// RUN: not %hirct-gen %S/../../fixtures/HierCyclic.mlir -o %t_cyclic --export-cmodel --top CycA 2>&1 | %FileCheck %s --check-prefix=CHECK-CYCLIC
// CHECK-CYCLIC: module instantiation cycle detected
// No artifacts should remain
// RUN: test ! -f %t_cyclic/CycA.h
// RUN: test ! -f %t_cyclic/CycB.h
//
// --- HierSelfInst: self-instantiation must be rejected ---
// RUN: rm -rf %t_self
// RUN: not %hirct-gen %S/../../fixtures/HierSelfInst.mlir -o %t_self --export-cmodel --top SelfMod 2>&1 | %FileCheck %s --check-prefix=CHECK-SELF
// CHECK-SELF: instantiates itself (self-instantiation)
// RUN: test ! -f %t_self/SelfMod.h
//
// --- HierWrapper (M4): --export-systemc-wrapper on hierarchy root is ALLOWED ---
// The wrapper targets the root's C model API; child modules stay as backend.
// HierSimple is comb-only (no clock), so wrapper has no clock_method.
// RUN: rm -rf %t_hierwrap
// RUN: %hirct-gen %S/../../fixtures/HierSimple.mlir -o %t_hierwrap --export-cmodel --export-systemc-wrapper --top Top
// RUN: test -f %t_hierwrap/Top_sc_wrapper.h
// RUN: test -f %t_hierwrap/Top_sc_wrapper.cpp
// RUN: test -f %t_hierwrap/Top.h
// RUN: test -f %t_hierwrap/Adder8.h
// RUN: %FileCheck %s --check-prefix=CHECK-HIER-WRAP-H < %t_hierwrap/Top_sc_wrapper.h
// RUN: %FileCheck %s --check-prefix=CHECK-HIER-WRAP-I < %t_hierwrap/Top_sc_wrapper.cpp
// CHECK-HIER-WRAP-H: SC_MODULE(Top_sc_wrapper)
// CHECK-HIER-WRAP-H: Top_state state_
// CHECK-HIER-WRAP-H: eval_method
// CHECK-HIER-WRAP-I: Top_initialize(&state_)
// CHECK-HIER-WRAP-I: Top_eval_comb(&state_)
//
// ============================================================================
// M3 Batch 3: topological ordering + acceptance closure
// ============================================================================
//
// --- HierOrdered: Producer eval_comb must appear before Consumer eval_comb ---
// RUN: rm -rf %t_b3_ordered
// RUN: %hirct-gen %S/../../fixtures/HierOrdered.mlir -o %t_b3_ordered --export-cmodel --top Pipeline
// RUN: test -f %t_b3_ordered/Pipeline.cpp
// RUN: test -f %t_b3_ordered/Producer.h
// RUN: test -f %t_b3_ordered/Consumer.h
// RUN: %FileCheck %s --check-prefix=CHECK-B3-ORD-CPP < %t_b3_ordered/Pipeline.cpp
//
// Topological order: Producer before Consumer (prod_out feeds cons input)
// CHECK-B3-ORD-CPP: Producer_eval_comb(&s->prod)
// CHECK-B3-ORD-CPP: Consumer_eval_comb(&s->cons)
//
// --- HierOrdered: staged binding of producer output used by consumer input ---
// RUN: %FileCheck %s --check-prefix=CHECK-B3-BIND < %t_b3_ordered/Pipeline.cpp
// CHECK-B3-BIND: prod_out = Producer_get_out(&s->prod)
// CHECK-B3-BIND: Consumer_set_data(&s->cons
//
// --- HierCrossRef Batch3: cross-module expression correctness ---
// RUN: rm -rf %t_b3_xref
// RUN: %hirct-gen %S/../../fixtures/HierCrossRef.mlir -o %t_b3_xref --export-cmodel --top Top
// RUN: %FileCheck %s --check-prefix=CHECK-B3-XREF < %t_b3_xref/Top.cpp
// Cross-ref: child output used in parent comb expression (add0_sum + 42)
// CHECK-B3-XREF: add0_sum = Adder8_get_sum(&s->add0)
// CHECK-B3-XREF: add0_sum
// CHECK-B3-XREF-NOT: unsupported:hw.instance
//
// --- MultiModule via export-cmodel: two ordered children (add1 before add2) ---
// RUN: rm -rf %t_b3_multi
// RUN: %hirct-gen %S/../../fixtures/MultiModule.mlir -o %t_b3_multi --export-cmodel --top MultiModule
// RUN: %FileCheck %s --check-prefix=CHECK-B3-MULTI < %t_b3_multi/MultiModule.cpp
// Topo order: add1 before add2 (add1_sum feeds add2 input)
// CHECK-B3-MULTI: Adder8_eval_comb(&s->add1)
// CHECK-B3-MULTI: Adder8_eval_comb(&s->add2)
//
// --- CyclicInstances: instance-level combinational cycle must be rejected ---
// RUN: rm -rf %t_b3_cycle
// RUN: not %hirct-gen %S/../../fixtures/CyclicInstances.mlir -o %t_b3_cycle --export-cmodel --top CyclicTop 2>&1 | %FileCheck %s --check-prefix=CHECK-B3-INST-CYCLE
// CHECK-B3-INST-CYCLE: error: combinational cycle detected among instances
// CHECK-B3-INST-CYCLE: involved instances:
// CHECK-B3-INST-CYCLE: instance topological sort requires a DAG
// No artifacts should be generated for the root module
// RUN: test ! -f %t_b3_cycle/CyclicTop.h
// RUN: test ! -f %t_b3_cycle/CyclicTop.cpp
//
// --- Compile-check: HierOrdered artifacts ---
// RUN: c++ -std=c++17 -fsyntax-only -I %t_b3_ordered %t_b3_ordered/Producer.cpp
// RUN: c++ -std=c++17 -fsyntax-only -I %t_b3_ordered %t_b3_ordered/Consumer.cpp
// RUN: c++ -std=c++17 -fsyntax-only -I %t_b3_ordered %t_b3_ordered/Pipeline.cpp
//
// --- Compile-check: MultiModule hierarchy artifacts ---
// RUN: c++ -std=c++17 -fsyntax-only -I %t_b3_multi %t_b3_multi/Adder8.cpp
// RUN: c++ -std=c++17 -fsyntax-only -I %t_b3_multi %t_b3_multi/MultiModule.cpp
//
// ============================================================================
// M3 Batch 2: parent-child integration
// ============================================================================
//
// --- HierSimple Batch2: parent includes child, embeds state, calls init/eval ---
// RUN: rm -rf %t_b2_simple
// RUN: %hirct-gen %S/../../fixtures/HierSimple.mlir -o %t_b2_simple --export-cmodel --top Top
// RUN: %FileCheck %s --check-prefix=CHECK-B2-ROOT-H < %t_b2_simple/Top.h
// RUN: %FileCheck %s --check-prefix=CHECK-B2-ROOT-CPP < %t_b2_simple/Top.cpp
//
// Parent header includes child header
// CHECK-B2-ROOT-H: #include "Adder8.h"
// Parent state embeds child state
// CHECK-B2-ROOT-H: Adder8_state add0
//
// Parent initialize calls child initialize
// CHECK-B2-ROOT-CPP: Adder8_initialize(&s->add0)
// Parent eval_comb calls child set/eval/get
// CHECK-B2-ROOT-CPP: Adder8_set_a(&s->add0
// CHECK-B2-ROOT-CPP: Adder8_set_b(&s->add0
// CHECK-B2-ROOT-CPP: Adder8_eval_comb(&s->add0)
// CHECK-B2-ROOT-CPP: Adder8_get_sum(&s->add0)
//
// --- HierCrossRef: staged binding, child output used in parent comb logic ---
// RUN: rm -rf %t_b2_xref
// RUN: %hirct-gen %S/../../fixtures/HierCrossRef.mlir -o %t_b2_xref --export-cmodel --top Top
// RUN: %FileCheck %s --check-prefix=CHECK-B2-XREF-H < %t_b2_xref/Top.h
// RUN: %FileCheck %s --check-prefix=CHECK-B2-XREF-CPP < %t_b2_xref/Top.cpp
//
// CHECK-B2-XREF-H: #include "Adder8.h"
// CHECK-B2-XREF-H: Adder8_state add0
//
// Staged binding: child output read into local variable
// CHECK-B2-XREF-CPP: add0_sum = Adder8_get_sum(&s->add0)
// Parent comb logic must NOT contain /* unsupported:hw.instance */0
// CHECK-B2-XREF-CPP-NOT: unsupported:hw.instance
// Parent output expression must reference the staged local (add0_sum)
// CHECK-B2-XREF-CPP: add0_sum
