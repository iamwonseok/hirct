// Test: instance output used as operand for subsequent comb logic
// (exercises staged binding: child output bound to local before parent comb use)
//
// Originally XFAIL for GenModel path (--only model). M3 Batch 3 closes this
// by exercising the --export-cmodel hierarchical path which uses staged binding
// to resolve cross-module references.
//
// RUN: rm -rf %t
// RUN: %hirct-gen %S/../../fixtures/HierCrossRef.mlir -o %t --export-cmodel --top Top
// RUN: %FileCheck %s --check-prefix=CHECK-H < %t/Top.h
// RUN: %FileCheck %s --check-prefix=CHECK-CPP < %t/Top.cpp
//
// CHECK-H: #include "Adder8.h"
// CHECK-H: Adder8_state add0
//
// CHECK-CPP: add0_sum = Adder8_get_sum(&s->add0)
// CHECK-CPP-NOT: unsupported:hw.instance
// CHECK-CPP: add0_sum
