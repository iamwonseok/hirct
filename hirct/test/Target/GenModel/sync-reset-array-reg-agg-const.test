// Test: array-type register with hw.aggregate_constant reset value.
// Verifies that extractHwArrayResetValues handles hw.aggregate_constant,
// producing correct per-element reset values in step() and do_reset().
//
// RUN: %hirct-gen %S/../../fixtures/SyncResetArrayRegAggConst.mlir -o %t --only model
// RUN: cat %t/cmodel/SyncResetArrayRegAggConst.cpp | %FileCheck %s --check-prefix=CHECK-CPP
// RUN: g++ -std=c++17 -fsyntax-only -I%t/cmodel %t/cmodel/SyncResetArrayRegAggConst.cpp
//
// step(): aggregate_constant reset must apply per-element values
// CHECK-CPP-LABEL: void SyncResetArrayRegAggConst::step()
// CHECK-CPP:       if (reset) {
// CHECK-CPP-NEXT:    reg_ssa_arr__reg[0] = static_cast<uint8_t>(42);
// CHECK-CPP-NEXT:    reg_ssa_arr__reg[1] = static_cast<uint8_t>(7);
// CHECK-CPP-NEXT:  } else {
// CHECK-CPP:         reg_ssa_arr__reg[__k] = next_ssa_arr__reg[__k];
//
// do_reset(): aggregate_constant per-element values, not all-zero
// CHECK-CPP-LABEL: void SyncResetArrayRegAggConst::do_reset()
// CHECK-CPP:       reg_ssa_arr__reg[0] = static_cast<uint8_t>(42)
// CHECK-CPP:       reg_ssa_arr__reg[1] = static_cast<uint8_t>(7)
