// Test: wide register reset semantics (> 64 bits) in multi-clock module.
// Verifies emit_domain_step emits per-word reset for both async firreg
// and sync compreg in their respective clock domains.
//
// RUN: %hirct-gen %S/../../fixtures/AsyncResetWideRegMultiClock.mlir -o %t --only model
// RUN: cat %t/cmodel/AsyncResetWideRegMultiClock.cpp | %FileCheck %s --check-prefix=CHECK-CPP
// RUN: g++ -std=c++17 -fsyntax-only -I%t/cmodel %t/cmodel/AsyncResetWideRegMultiClock.cpp
//
// step_pclk(): wide async-reset firreg must check reset and assign per-word
// CHECK-CPP-LABEL: void AsyncResetWideRegMultiClock::step_pclk()
// CHECK-CPP:       if (reset) {
// CHECK-CPP-NEXT:    reg_ssa_reg128__async[0] = static_cast<uint64_t>(14627333965257922168ULL);
// CHECK-CPP:         reg_ssa_reg128__async[1] = static_cast<uint64_t>(170);
// CHECK-CPP:       } else {
// CHECK-CPP-NEXT:    for (unsigned __k = 0; __k < 2; ++__k) reg_ssa_reg128__async[__k] = next_ssa_reg128__async[__k];
//
// step_sclk(): wide sync-reset compreg must check reset and assign per-word
// CHECK-CPP-LABEL: void AsyncResetWideRegMultiClock::step_sclk()
// CHECK-CPP:       if (reset) {
// CHECK-CPP-NEXT:    reg_ssa_reg128__sync[0] = static_cast<uint64_t>(16045690981097406465ULL);
// CHECK-CPP:         reg_ssa_reg128__sync[1] = static_cast<uint64_t>(187);
// CHECK-CPP:       } else {
// CHECK-CPP-NEXT:    for (unsigned __k = 0; __k < 2; ++__k) reg_ssa_reg128__sync[__k] = next_ssa_reg128__sync[__k];
//
// do_reset(): wide register per-word initialization
// CHECK-CPP-LABEL: void AsyncResetWideRegMultiClock::do_reset()
// CHECK-CPP:       reg_ssa_reg128__async[0] = static_cast<uint64_t>(14627333965257922168ULL);
// CHECK-CPP:       reg_ssa_reg128__async[1] = static_cast<uint64_t>(170);
// CHECK-CPP:       reg_ssa_reg128__sync[0] = static_cast<uint64_t>(16045690981097406465ULL);
// CHECK-CPP:       reg_ssa_reg128__sync[1] = static_cast<uint64_t>(187);
