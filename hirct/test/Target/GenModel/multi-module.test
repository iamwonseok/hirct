// Test: multi-module MLIR with hw.instance support
// Verifies hierarchical export generates per-module artifacts with correct
// parent-child integration via --export-cmodel.
//
// Originally XFAIL for GenModel path (--only model). M3 Batch 3 closes this
// by exercising the --export-cmodel hierarchical path.
//
// RUN: rm -rf %t
// RUN: %hirct-gen %S/../../fixtures/MultiModule.mlir -o %t --export-cmodel --top MultiModule
// RUN: test -f %t/MultiModule.h
// RUN: test -f %t/MultiModule.cpp
// RUN: test -f %t/Adder8.h
// RUN: test -f %t/Adder8.cpp
//
// RUN: %FileCheck %s --check-prefix=CHECK-TOP < %t/MultiModule.h
// RUN: %FileCheck %s --check-prefix=CHECK-CPP < %t/MultiModule.cpp
// RUN: %FileCheck %s --check-prefix=CHECK-SUB < %t/Adder8.h
//
// Parent header includes child and embeds child state
// CHECK-TOP: #include "Adder8.h"
// CHECK-TOP: Adder8_state add1
// CHECK-TOP: Adder8_state add2
//
// Parent eval_comb calls children in topo order (add1 before add2)
// CHECK-CPP: Adder8_eval_comb(&s->add1)
// CHECK-CPP: Adder8_eval_comb(&s->add2)
//
// Child header has its own state and eval
// CHECK-SUB: Adder8_state
// CHECK-SUB: Adder8_eval_comb
//
// Compile-check both artifacts
// RUN: c++ -std=c++17 -fsyntax-only -I %t %t/Adder8.cpp
// RUN: c++ -std=c++17 -fsyntax-only -I %t %t/MultiModule.cpp
