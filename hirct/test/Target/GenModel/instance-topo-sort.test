// Test: instance topological sort in eval_comb
// Producer must be evaluated before Consumer because Consumer.data depends
// combinationally on Producer.out.
//
// Originally XFAIL for GenModel path (--only model). M3 Batch 3 closes this
// by exercising the --export-cmodel hierarchical path which uses topological
// ordering for child eval sequences.
//
// RUN: rm -rf %t
// RUN: %hirct-gen %S/../../fixtures/HierOrdered.mlir -o %t --export-cmodel --top Pipeline
// RUN: %FileCheck %s < %t/Pipeline.cpp
//
// CHECK: Producer_eval_comb(&s->prod)
// CHECK: Consumer_eval_comb(&s->cons)
