// Test: array-type register reset semantics in single-clock module.
// Verifies that step() emits a reset branch for array-typed compreg,
// and that do_reset() applies per-element reset values (not all-zero).
//
// RUN: %hirct-gen %S/../../fixtures/SyncResetArrayReg.mlir -o %t --only model
// RUN: cat %t/cmodel/SyncResetArrayReg.cpp | %FileCheck %s --check-prefix=CHECK-CPP
// RUN: g++ -std=c++17 -fsyntax-only -I%t/cmodel %t/cmodel/SyncResetArrayReg.cpp
//
// step(): array compreg must check reset and apply per-element reset values
// CHECK-CPP-LABEL: void SyncResetArrayReg::step()
// CHECK-CPP:       if (reset) {
// CHECK-CPP-NEXT:    reg_ssa_arr__reg[0] = static_cast<uint8_t>(42);
// CHECK-CPP-NEXT:    reg_ssa_arr__reg[1] = static_cast<uint8_t>(0);
// CHECK-CPP-NEXT:  } else {
// CHECK-CPP:         reg_ssa_arr__reg[__k] = next_ssa_arr__reg[__k];
//
// do_reset(): must initialise with per-element reset values, not all-zero
// CHECK-CPP-LABEL: void SyncResetArrayReg::do_reset()
// CHECK-CPP:       reg_ssa_arr__reg[0] = static_cast<uint8_t>(42)
// CHECK-CPP:       reg_ssa_arr__reg[1] = static_cast<uint8_t>(0)
