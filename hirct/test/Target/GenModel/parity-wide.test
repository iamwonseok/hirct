// Test: comb.parity must handle inputs wider than 64 bits.
// Wide port (i128) is stored as uint64_t[2]; parity must use word-level access.
//
// RUN: %hirct-gen %S/../../fixtures/ParityWide.mlir -o %t --only model
// RUN: cat %t/cmodel/ParityWide.cpp | %FileCheck %s
// RUN: g++ -std=c++17 -fsyntax-only -I%t/cmodel %t/cmodel/ParityWide.cpp
//
// CHECK: __builtin_parityll(in[0])
// CHECK-SAME: __builtin_parityll(in[1])
