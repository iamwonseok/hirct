// Test: narrow register reset semantics in single-clock module.
// Verifies sync compreg emits reset branch in step(), and async firreg
// continues to work (regression guard).
//
// RUN: %hirct-gen %S/../../fixtures/SyncResetNarrowReg.mlir -o %t --only model
// RUN: cat %t/cmodel/SyncResetNarrowReg.cpp | %FileCheck %s --check-prefix=CHECK-CPP
// RUN: g++ -std=c++17 -fsyntax-only -I%t/cmodel %t/cmodel/SyncResetNarrowReg.cpp
//
// step(): async firreg must check reset (regression guard)
// CHECK-CPP-LABEL: void SyncResetNarrowReg::step()
// CHECK-CPP:       if (reset)
// CHECK-CPP-NEXT:    reg_ssa_reg1 = 1;
// CHECK-CPP-NEXT:  else
// CHECK-CPP:         reg_ssa_reg1 = next_ssa_reg1;
//
// step(): sync compreg must check reset and assign reset value (42)
// CHECK-CPP:       if (reset)
// CHECK-CPP-NEXT:    reg_ssa_reg8 = 42;
// CHECK-CPP-NEXT:  else
// CHECK-CPP:         reg_ssa_reg8 = next_ssa_reg8;
