// Test: narrow register reset semantics in multi-clock module.
// Verifies sync compreg emits reset branch in domain_step for each clock domain.
//
// RUN: %hirct-gen %S/../../fixtures/SyncResetNarrowRegMultiClock.mlir -o %t --only model
// RUN: cat %t/cmodel/SyncResetNarrowRegMultiClock.cpp | %FileCheck %s --check-prefix=CHECK-CPP
// RUN: g++ -std=c++17 -fsyntax-only -I%t/cmodel %t/cmodel/SyncResetNarrowRegMultiClock.cpp
//
// domain_step for clock domain A: sync compreg must check reset (value 42)
// CHECK-CPP-LABEL: void SyncResetNarrowRegMultiClock::step_clka()
// CHECK-CPP:       if (reset)
// CHECK-CPP-NEXT:    reg_ssa_regA = 42;
// CHECK-CPP-NEXT:  else
// CHECK-CPP:         reg_ssa_regA = next_ssa_regA;
//
// domain_step for clock domain B: sync compreg must check reset (value 1000)
// CHECK-CPP-LABEL: void SyncResetNarrowRegMultiClock::step_clkb()
// CHECK-CPP:       if (reset)
// CHECK-CPP-NEXT:    reg_ssa_regB = 1000;
// CHECK-CPP-NEXT:  else
// CHECK-CPP:         reg_ssa_regB = next_ssa_regB;
