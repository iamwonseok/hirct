// Test: wide constants (>= 64 bits) must not crash with APInt::getZExtValue()
// assert, and wide scalar registers must preserve the uint64_t[N] storage
// contract end-to-end.
//
// Regression test for KL-3: i128/i384 ConstantOp in EmitExpr and GenModel
// reset_val.
//
// RUN: %hirct-gen %S/../../fixtures/WideConstant.mlir -o %t --only model
// RUN: cat %t/cmodel/WideConstant.h | %FileCheck %s --check-prefix=CHECK-H
// RUN: cat %t/cmodel/WideConstant.cpp | %FileCheck %s --check-prefix=CHECK-CPP
// RUN: g++ -std=c++17 -fsyntax-only -I%t/cmodel %t/cmodel/WideConstant.cpp
//
// Verify wide scalar registers are stored as per-word arrays.
// CHECK-H: uint64_t reg_ssa_reg128[2];
// CHECK-H: uint64_t next_ssa_reg128[2];
// CHECK-H: uint64_t reg_ssa_reg384[6];
// CHECK-H: uint64_t next_ssa_reg384[6];
//
// Verify eval_comb()/step() use word-level copies for wide scalar registers.
// CHECK-CPP-LABEL: void WideConstant::eval_comb()
// CHECK-CPP: for (unsigned __k = 0; __k < 2; ++__k) next_ssa_reg128[__k] = static_cast<uint64_t>(d128[__k]);
// CHECK-CPP: for (unsigned __k = 0; __k < 6; ++__k) next_ssa_reg384[__k] = static_cast<uint64_t>(d384[__k]);
// CHECK-CPP: out128[0] = reg_ssa_reg128[0];
// CHECK-CPP: out384[5] = reg_ssa_reg384[5];
//
// CHECK-CPP-LABEL: void WideConstant::step()
// CHECK-CPP: for (unsigned __k = 0; __k < 2; ++__k) reg_ssa_reg128[__k] = next_ssa_reg128[__k];
// CHECK-CPP: for (unsigned __k = 0; __k < 6; ++__k) reg_ssa_reg384[__k] = next_ssa_reg384[__k];
//
// Verify do_reset() emits per-word initialization without crashing.
// CHECK-CPP-LABEL: void WideConstant::do_reset()
// CHECK-CPP: reg_ssa_reg128[0] = static_cast<uint64_t>(16045690984503098046ULL);
// CHECK-CPP: reg_ssa_reg128[1] = static_cast<uint64_t>(0);
// CHECK-CPP: reg_ssa_reg384[0] = static_cast<uint64_t>(1808788007904223008);
// CHECK-CPP: reg_ssa_reg384[1] = static_cast<uint64_t>(1230066625199609624);
// CHECK-CPP: reg_ssa_reg384[3] = static_cast<uint64_t>(72623859790382856);
// CHECK-CPP: reg_ssa_reg384[4] = static_cast<uint64_t>(0);
